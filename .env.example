# ── Application Environment ──
DEBUG=false
HOST=0.0.0.0
PORT=8000
SECRET_KEY=generate_a_random_secure_secret_key_here

# ── Database (PostgreSQL + PostGIS in Production, SQLite fallback) ──
# Production PostgreSQL URL format:
# postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://anpr_user:anpr_secure_pass@db:5432/anpr_db
# Local SQLite fallback:
# DATABASE_URL=sqlite:///data/anpr.db

# ── CORS Origins (Comma-separated) ──
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,http://localhost:8000

# ── File Upload Size Limits ──
MAX_IMAGE_UPLOAD_MB=15
MAX_VIDEO_UPLOAD_MB=100

# ── WebSocket Configuration ──
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=500

# ── Surveillance & Alert Thresholds ──
SPEED_ANOMALY_THRESHOLD_KMH=75.0
GEOFENCE_CHECK_INTERVAL=10
VIDEO_TARGET_FPS=5

# ── Docker / Database Credentials (used by docker-compose) ──
POSTGRES_DB=anpr_db
POSTGRES_USER=anpr_user
POSTGRES_PASSWORD=anpr_secure_pass
